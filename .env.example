# Database Configuration
# Database Configuration
DATABASE_URL=file:./prisma/dev.db

# Turso Database Configuration (Required for Production)
TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Authentication (REQUIRED - must be at least 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-chars

# MFA Trust Token Secret (REQUIRED - for multi-factor authentication)
MFA_TRUST_SECRET=your-mfa-trust-secret-key-here-minimum-32-chars

# Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_FROM=your-email@domain.com

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# Optional: Unsplash API for car images
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
