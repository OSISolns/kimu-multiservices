generator client {
  provider = "prisma-client-js"
  // Use default output in node_modules/.prisma to avoid Windows file locks on engine DLLs
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int      @id @default(autoincrement())
  username              String   @unique
  fullName              String?
  email                 String?
  phone                 String?
  passwordHash          String
  role                  String   @default("agent")
  department            String?
  status                String   @default("active")
  profilePicture        String?
  createdAt             DateTime @default(now())
  lastLogin             DateTime?
  totpSecret            String?
  emailNotifications    Boolean  @default(false)
  whatsappNotifications Boolean  @default(false)
  
  trustedDevices        TrustedDevice[]
  employee              Employee?
  reportTemplates       ReportTemplate[]
  reports               Report[]
  dashboards            Dashboard[]
  analyticsEvents       AnalyticsEvent[]
}

model Vehicle {
  id                    Int      @id @default(autoincrement())
  name                  String
  image                 String
  type                  String
  category              String
  price                 String
  year                  Int
  engine                String
  mileage               String
  transmission          String
  fuel                  String
  capacity              String
  doors                 Int
  description           String
  isAvailable           Boolean  @default(true)
  power                 String
  fuelEfficiency        String
  quantity              Int      @default(1)
  status                String   @default("available")
  maintenanceNotes      String?
  maintenanceDate       DateTime?
  quantityUpdateReason  String?
  quantityUpdateDate    DateTime?
  licensePlate          String?
  vehicleId             String?
}

model Booking {
  id               Int      @id @default(autoincrement())
  type             String
  name             String?
  email            String?
  phone            String?
  nationality      String?
  idOrPassport     String?
  carType          String?
  pickupDate       String?
  pickupTime       String?
  returnDate       String?
  returnTime       String?
  rentalDays       Int?
  returnConfirmed  Boolean @default(false)
  fullTank         Boolean @default(false)
  status           String  @default("Active")
  createdAt        DateTime @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int?
  message     String
  type        String
  read        Boolean @default(false)
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  createdBy Int?
  createdAt DateTime @default(now())
}

model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  bookingType   String   // e.g. "Car Rental", "Hotel", "Taxi"
  amount        Float
  currency      String   @default("RWF")
  paymentMethod String   // "cash", "card", "mobile_money", "bank_transfer"
  status        String   // "pending", "completed", "failed", "refunded"
  transactionId String?
  paymentDate   DateTime @default(now())
  userId        Int?
}

model TrustedDevice {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceId    String   // Browser fingerprint/device identifier
  deviceName  String?  // Optional human-readable device name
  userAgent   String?  // Store user agent for reference
  ipAddress   String?  // Store IP for additional security
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Trust expires after 30 days
  lastUsed    DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([expiresAt])
}

model Lead {
  id            Int      @id @default(autoincrement())
  name          String
  company       String
  stage         String   @default("Contacted")
  value         Float    @default(0)
  contact       String?
  email         String?
  location      String?
  lastContact   DateTime @default(now())
  nextFollowUp  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  quotes        Quote[]
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  reach       Int      @default(0)
  engagement  Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  budget      Float    @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  client   String
  activity String
  outcome  String
  type     String   @default("call")
  createdAt DateTime @default(now())
}

model Quote {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Lead     @relation(fields: [customerId], references: [id])
  serviceType String
  amount      Float
  currency    String   @default("RWF")
  validUntil  DateTime
  status      String   @default("draft") // draft, sent, accepted, rejected, expired
  notes       String?
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Accounting Models
model Income {
  id            Int      @id @default(autoincrement())
  description   String
  amount        Float
  category      String   // car_rental, taxi_service, airport_transfer, hotel, car_sales, other
  paymentMethod String   // MTN Momo, Equity Bank, BK Bank, Cash
  date          DateTime
  reference     String?
  notes         String?
  clientName    String?
  clientPhone   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Expense {
  id            Int      @id @default(autoincrement())
  description   String
  amount        Float
  category      String   // fuel, maintenance, insurance, salaries, utilities, office, marketing, other
  paymentMethod String   // MTN Momo, Equity Bank, BK Bank, Cash
  date          DateTime
  receiptNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  clientName    String
  clientEmail   String
  clientPhone   String?
  amount        Float
  taxRate       Float    @default(18) // Rwanda VAT rate
  taxAmount     Float
  totalAmount   Float
  grandTotal    Float
  dueDate       DateTime
  description   String
  items         Json     // Array of invoice items
  status        String   @default("pending") // pending, outstanding, paid
  emailSent     Boolean  @default(false)
  emailSentAt   DateTime?
  emailSubject  String?
  emailMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id          Int      @id @default(autoincrement())
  category    String   // fuel, maintenance, insurance, salaries, utilities, office, marketing, other
  amount      Float
  period      String   // monthly, quarterly, yearly
  year        Int
  month       Int?
  quarter     Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([category, period, year, month, quarter])
}

// Analytics and Reporting Models
model ReportTemplate {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  category          String   // financial, operational, customer, employee
  query             Json     // Report query configuration
  parameters        Json?    // Report parameters schema
  isActive          Boolean  @default(true)
  createdBy         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  reports           Report[]
  
  @@index([category])
  @@index([isActive])
}

model Report {
  id                Int      @id @default(autoincrement())
  templateId        Int?
  name              String
  description       String?
  category          String
  type              String   // scheduled, on_demand, real_time
  status            String   @default("pending") // pending, running, completed, failed
  parameters        Json?    // Report parameters used
  filters           Json?    // Applied filters
  data              Json?    // Report data/results
  filePath          String?  // Path to generated file
  fileFormat        String?  // pdf, excel, csv, json
  generatedBy       Int
  generatedAt       DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  template          ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user              User     @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
  
  @@index([category])
  @@index([type])
  @@index([status])
  @@index([generatedBy])
}

model Dashboard {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  layout            Json     // Dashboard layout configuration
  widgets           Json     // Widget configurations
  isPublic          Boolean  @default(false)
  isDefault         Boolean  @default(false)
  createdBy         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  
  @@index([isPublic])
  @@index([isDefault])
}

model AnalyticsEvent {
  id                Int      @id @default(autoincrement())
  eventType         String   // page_view, user_action, system_event, business_event
  eventName         String
  properties        Json?    // Event properties
  userId            Int?
  sessionId         String?
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime @default(now())
  
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([eventType])
  @@index([eventName])
  @@index([userId])
  @@index([timestamp])
}

model Employee {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  employeeId        String   @unique
  position          String
  department        String
  employmentType    String   // full-time, part-time, contract
  hireDate          DateTime
  salary            Float
  bankAccount       String?
  taxId             String?
  socialSecurityId  String?
  status            String   @default("active") // active, inactive, terminated
  terminationDate   DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryStructures  SalaryStructure[]
  payrollItems      PayrollItem[]
  payrolls          Payroll[]

  @@index([employeeId])
  @@index([department])
  @@index([status])
}

model SalaryStructure {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  baseSalary   Float
  allowances   Json     // JSON object for various allowances
  deductions   Json     // JSON object for various deductions
  effectiveDate DateTime
  endDate      DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
}

model Payroll {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  period           String   // e.g., "2024-01"
  year             Int
  month            Int
  status           String   @default("draft") // draft, processed, paid
  grossSalary      Float
  netSalary        Float
  totalAllowances  Float    @default(0)
  totalDeductions  Float    @default(0)
  workingDays      Int
  actualDays       Int
  overtimeHours    Float    @default(0)
  overtimePay      Float    @default(0)
  bonus            Float    @default(0)
  advance          Float    @default(0)
  loanDeduction    Float    @default(0)
  taxDeduction     Float    @default(0)
  socialSecurity   Float    @default(0)
  otherDeductions  Float    @default(0)
  paymentMethod    String?  // bank, cash, mobile_money
  paymentDate      DateTime?
  processedBy      Int?
  processedAt      DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItems     PayrollItem[]

  @@index([employeeId])
  @@index([period])
  @@index([status])
  @@index([year, month])
}

model PayrollItem {
  id          Int      @id @default(autoincrement())
  payrollId   Int
  employeeId  Int
  type        String   // allowance, deduction, bonus, etc.
  name        String
  amount      Float
  percentage  Float?
  description String?
  createdAt   DateTime @default(now())

  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([employeeId])
  @@index([type])
}