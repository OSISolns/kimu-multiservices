generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int      @id @default(autoincrement())
  username              String   @unique
  fullName              String?
  email                 String?
  phone                 String?
  passwordHash          String
  role                  String   @default("agent")
  department            String?
  status                String   @default("active")
  profilePicture        String?
  createdAt             DateTime @default(now())
  totpSecret            String?
  emailNotifications    Boolean  @default(false)
  whatsappNotifications Boolean  @default(false)

  trustedDevices TrustedDevice[]
}

model Vehicle {
  id                   Int       @id @default(autoincrement())
  name                 String
  image                String
  type                 String
  category             String
  price                String
  year                 Int
  engine               String
  mileage              String
  transmission         String
  fuel                 String
  capacity             String
  doors                Int
  description          String
  isAvailable          Boolean   @default(true)
  power                String
  fuelEfficiency       String
  quantity             Int       @default(1)
  status               String    @default("available")
  maintenanceNotes     String?
  maintenanceDate      DateTime?
  quantityUpdateReason String?
  quantityUpdateDate   DateTime?
  licensePlate         String?
  vehicleId            String?
}

model Booking {
  id              Int      @id @default(autoincrement())
  type            String
  name            String?
  email           String?
  phone           String?
  nationality     String?
  idOrPassport    String?
  carType         String?
  pickupDate      String?
  pickupTime      String?
  returnDate      String?
  returnTime      String?
  rentalDays      Int?
  returnConfirmed Boolean  @default(false)
  fullTank        Boolean  @default(false)
  status          String   @default("Active")
  createdAt       DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  createdBy Int?
  createdAt DateTime @default(now())
}

model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  bookingType   String // e.g. "Car Rental", "Hotel", "Taxi"
  amount        Float
  currency      String   @default("RWF")
  paymentMethod String // "cash", "card", "mobile_money", "bank_transfer"
  status        String // "pending", "completed", "failed", "refunded"
  transactionId String?
  paymentDate   DateTime @default(now())
  userId        Int?
}

model TrustedDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceId   String // Browser fingerprint/device identifier
  deviceName String? // Optional human-readable device name
  userAgent  String? // Store user agent for reference
  ipAddress  String? // Store IP for additional security
  createdAt  DateTime @default(now())
  expiresAt  DateTime // Trust expires after 30 days
  lastUsed   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([expiresAt])
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  company      String
  stage        String   @default("Contacted")
  value        Float    @default(0)
  contact      String?
  email        String?
  location     String?
  lastContact  DateTime @default(now())
  nextFollowUp DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  reach       Int      @default(0)
  engagement  Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  budget      Float    @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  client    String
  activity  String
  outcome   String
  type      String   @default("call")
  createdAt DateTime @default(now())
}
